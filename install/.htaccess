# 禁止直接访问安装 / 迁移 / 维护脚本
# ---------------------------------------------------------------
# install/ 下除了安装向导，其余脚本都会直接连数据库、执行
# ALTER / TRUNCATE / DELETE，绝不能暴露给浏览器：
#   · migrate_*.php  反复重跑会扰乱数据
#   · clear_logs.php 可清空审计日志（销毁入侵痕迹）
#   · schema.sql / install.lock 可被直接下载
#
# install.php 是唯一例外：安装向导必须能被浏览器访问，
# 它内部用 install/install.lock 判断「是否已安装」。
# 【安装完成后应当直接删除整个 install 目录】，本文件只是兜底。
#
# 注意：本文件只在 Apache 下生效（且需 AllowOverride）。
# 其它 Web 服务器请参考 install/nginx.conf.example，
# 并依赖脚本自带的 PHP 层自检（install/_cli_guard.php，与服务器无关）。
# ---------------------------------------------------------------

# 1. 默认全拒
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# 2. 只放行安装向导
<Files "install.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# 3. 即便在 install.php 所在目录，锁文件与结构文件也不许下载
<FilesMatch "\.(lock|sql|example|md|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
